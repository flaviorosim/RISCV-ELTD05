module cpu (
	CLK,
	Reset,
	Data_BUS_READ,
	Prog_BUS_READ,
	ADDR,
	Data_BUS_WRITE,
	ADDR_Prog,
	CS,
	WE,
	CS_P,
	debug_PC,
	debug_WRITE_DATA,
	debug_WRITE_ADDR,
	debug_WE,
	debug_CS);
